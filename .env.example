# Google service account (read-only access to the sheet — see README "Google Sheets access")
GOOGLE_SERVICE_ACCOUNT_EMAIL=case-watch-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=paste_the_id_from_the_sheet_url_here

# Supabase (see README "Supabase setup")
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_key_here

# These two are NOT secret — they're the public values the browser dashboard
# uses. They go in public/config.js, not here. Listed for reference only:
# SUPABASE_ANON_KEY=paste_anon_public_key_here
